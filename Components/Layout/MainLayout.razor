@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Routing
@* 1. Navigatsiya xizmatini ulash *@
@inject NavigationManager NavigationManager

<div class="page-container">
    @* --- ORQA FON EFFEKTI --- *@
    <div class="bg-visuals">
        <div class="glow-orb orb-1"></div>
        <div class="glow-orb orb-2"></div>
    </div>

    @* === 1. PREMIUM SIDEBAR === *@
    <aside class="sidebar @(IsCollapsed ? "collapsed" : "")">
        <div class="sidebar-header">
            <div class="brand-wrapper">
                <div class="logo-box">
                    <span class="logo-text">SM</span>
                    <div class="logo-orb"></div>
                </div>
                @if (!IsCollapsed)
                {
                    <div class="brand-details">
                        <span class="brand-name">Samandar M.</span>
                        <div class="status-indicator">
                            <span class="pulse-dot"></span>
                            <span class="status-text">Online</span>
                        </div>
                    </div>
                }
            </div>
        </div>

        <nav class="nav-container">
            <div class="nav-group">
                @if (!IsCollapsed)
                {
                    <p class="group-label">Menyu</p>
                }

                <NavLink href="" class="nav-card" Match="NavLinkMatch.All">
                    <div class="nav-card-inner">
                        <div class="nav-icon"><i class="fas fa-home"></i></div>
                        @if (!IsCollapsed)
                        {
                            <div class="nav-info">
                                <span class="nav-title">Bosh sahifa</span>
                            </div>
                        }
                    </div>
                </NavLink>

                <NavLink href="about" class="nav-card">
                    <div class="nav-card-inner">
                        <div class="nav-icon"><i class="fas fa-user"></i></div>
                        @if (!IsCollapsed)
                        {
                            <div class="nav-info">
                                <span class="nav-title">Men haqimda</span>
                            </div>
                        }
                    </div>
                </NavLink>

                <NavLink href="projects" class="nav-card">
                    <div class="nav-card-inner">
                        <div class="nav-icon"><i class="fas fa-folder-open"></i></div>
                        @if (!IsCollapsed)
                        {
                            <div class="nav-info">
                                <span class="nav-title">Loyihalar</span>
                            </div>
                        }
                    </div>
                </NavLink>

                <NavLink href="skills" class="nav-card">
                    <div class="nav-card-inner">
                        <div class="nav-icon"><i class="fas fa-code"></i></div>
                        @if (!IsCollapsed)
                        {
                            <div class="nav-info">
                                <span class="nav-title">Ko'nikmalar</span>
                            </div>
                        }
                    </div>
                </NavLink>

                <NavLink href="services" class="nav-card">
                    <div class="nav-card-inner">
                        <div class="nav-icon"><i class="fas fa-briefcase"></i></div>
                        @if (!IsCollapsed)
                        {
                            <div class="nav-info">
                                <span class="nav-title">Xizmatlar</span>
                            </div>
                        }
                    </div>
                </NavLink>

                <button class="nav-card btn-link-style" @onclick="@(() => NavigationManager.NavigateTo("/contact"))">
                    <div class="nav-card-inner">
                        <div class="nav-icon"><i class="fas fa-envelope"></i></div>
                        @if (!IsCollapsed)
                        {
                            <div class="nav-info">
                                <span class="nav-title">Aloqa</span>
                            </div>
                        }
                    </div>
                </button>
            </div>
        </nav>

        <div class="sidebar-bottom">
            @if (!IsCollapsed)
            {
                <a href="files/SamandarResume.pdf" download class="cv-download-btn">
                    <i class="fas fa-file-download"></i>
                    <span>CV yuklab olish</span>
                </a>
            }
            else
            {
                <a href="files/SamandarResume.pdf" download class="cv-download-btn collapsed-btn" title="CV yuklab olish">
                    <i class="fas fa-file-download"></i>
                </a>
            }
        </div>
    </aside>

    @* === 2. ASOSIY KONTENT AREA === *@
    <main class="main-content">
        @* TOP NAVIGATION BAR *@
        <header class="top-bar">
            <div class="breadcrumb">
                <button class="toggle-btn" @onclick="ToggleSidebar">
                    <i class="fas fa-bars"></i>
                </button>
                <span class="page-name">Portfolio</span>
            </div>
            <div class="top-actions">
                <a href="https://github.com/SamandarHijiakbarovich" target="_blank" rel="noopener" class="action-btn" title="GitHub">
                    <i class="fab fa-github"></i>
                </a>
                <a href="https://t.me/LinuxInstructor" target="_blank" rel="noopener" class="action-btn" title="Telegram">
                    <i class="fab fa-telegram-plane"></i>
                </a>
                <a href="mailto:mamasoatovsamandar@gmail.com" class="action-btn" title="Email">
                    <i class="fas fa-envelope"></i>
                </a>
            </div>
        </header>

        <div class="content-wrapper">
            <div class="glass-container">
                @Body
            </div>
        </div>
    </main>
</div>

<style>
    :root {
        --side-w: 300px;
        --c-bg: #030712;
        --c-side: rgba(11, 15, 26, 0.95);
        --c-accent: #6366f1;
        --c-accent-glow: rgba(99, 102, 241, 0.4);
        --c-text: #f9fafb;
        --c-subtext: #94a3b8;
        --glass: rgba(255, 255, 255, 0.03);
        --border: rgba(255, 255, 255, 0.08);
        --grad: linear-gradient(135deg, #6366f1 0%, #a855f7 100%);
        --trans: all 0.4s cubic-bezier(0.23, 1, 0.32, 1);
    }

    .bg-visuals {
        position: fixed;
        inset: 0;
        z-index: -1;
        overflow: hidden;
        background: var(--c-bg);
    }

    .glow-orb {
        position: absolute;
        border-radius: 50%;
        filter: blur(100px);
        opacity: 0.15;
    }

    .orb-1 {
        width: 500px;
        height: 500px;
        background: var(--c-accent);
        top: -100px;
        right: -100px;
    }

    .orb-2 {
        width: 400px;
        height: 400px;
        background: #a855f7;
        bottom: -100px;
        left: -100px;
    }

    .page-container {
        display: flex;
        min-height: 100vh;
    }

    .sidebar {
        width: var(--side-w);
        height: 100vh;
        background: var(--c-side);
        position: fixed;
        border-right: 1px solid var(--border);
        display: flex;
        flex-direction: column;
        z-index: 100;
        backdrop-filter: blur(10px);
        transition: var(--trans);
    }

        .sidebar.collapsed {
            width: 85px;
        }

    .sidebar-header {
        padding: 2rem 1.5rem;
    }

    .brand-wrapper {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px;
        background: rgba(255,255,255,0.02);
        border-radius: 18px;
        border: 1px solid var(--border);
        min-width: 0;
    }

    .brand-details {
        min-width: 0;
        flex: 1;
        overflow: hidden;
    }

    .brand-name {
        display: block;
        font-weight: 700;
        font-size: 0.95rem;
        color: var(--c-text);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        letter-spacing: 0.2px;
    }

    .status-indicator {
        display: flex;
        align-items: center;
        gap: 6px;
        margin-top: 3px;
        font-size: 0.72rem;
        color: #10b981;
        font-weight: 500;
    }

    .pulse-dot {
        width: 7px;
        height: 7px;
        background: #10b981;
        border-radius: 50%;
        box-shadow: 0 0 8px #10b981;
        animation: pulse 2s infinite;
        flex-shrink: 0;
    }

    @@keyframes pulse {
        0%, 100% { opacity: 1; transform: scale(1); }
        50%      { opacity: 0.5; transform: scale(1.25); }
    }

    .logo-box {
        width: 44px;
        height: 44px;
        min-width: 44px;
        background: var(--grad);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        flex-shrink: 0;
    }

    .logo-text {
        font-weight: 900;
        font-size: 1.05rem;
        color: white;
        letter-spacing: -0.5px;
    }

    .nav-container {
        flex: 1;
        padding: 0 1rem;
    }

    .group-label {
        font-size: 0.65rem;
        color: var(--c-subtext);
        letter-spacing: 2px;
        margin: 1.5rem 0.5rem 0.75rem;
    }

    .nav-card {
        text-decoration: none;
        display: block;
        margin-bottom: 8px;
        border: none;
        background: none;
        width: 100%;
        cursor: pointer;
        padding: 0;
    }

    .nav-card-inner {
        display: flex;
        align-items: center;
        padding: 12px;
        border-radius: 15px;
        transition: var(--trans);
        border: 1px solid transparent;
    }

    .nav-icon {
        width: 38px;
        height: 38px;
        min-width: 38px;
        background: var(--glass);
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--c-subtext);
        font-size: 1.1rem;
        margin-right: 12px;
        transition: 0.3s;
    }

    .collapsed .nav-icon {
        margin-right: 0;
    }

    .nav-title {
        display: block;
        font-weight: 600;
        font-size: 0.9rem;
        color: var(--c-text);
        text-align: left;
    }

    .nav-desc {
        display: block;
        font-size: 0.7rem;
        color: var(--c-subtext);
        opacity: 0.6;
        text-align: left;
    }

    .nav-card:hover .nav-card-inner {
        background: var(--glass);
        transform: translateX(5px);
    }

    .nav-card.active .nav-card-inner {
        background: rgba(99, 102, 241, 0.1);
        border-left: 3px solid var(--c-accent);
    }

    .nav-card.active .nav-icon {
        background: var(--grad);
        color: white;
        box-shadow: 0 0 15px var(--c-accent-glow);
    }

    .top-bar {
        height: 64px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 2rem;
        background: rgba(3, 7, 18, 0.6);
        backdrop-filter: blur(12px);
        position: sticky;
        top: 0;
        z-index: 90;
        border-bottom: 1px solid var(--border);
    }

    .breadcrumb {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .page-name {
        font-size: 0.95rem;
        font-weight: 600;
        color: var(--c-text);
        letter-spacing: 0.2px;
    }

    .top-actions {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .action-btn {
        width: 38px;
        height: 38px;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid var(--border);
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--c-subtext);
        font-size: 0.95rem;
        text-decoration: none;
        transition: var(--trans);
        cursor: pointer;
    }

    .action-btn:hover {
        background: rgba(99, 102, 241, 0.1);
        border-color: rgba(99, 102, 241, 0.3);
        color: var(--c-text);
        transform: translateY(-2px);
    }

    /* CV Download Button in sidebar-bottom */
    .sidebar-bottom {
        padding: 1.2rem 1rem 1.4rem;
    }

    .cv-download-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        padding: 13px 16px;
        background: var(--grad);
        color: white;
        border-radius: 12px;
        text-decoration: none;
        font-weight: 600;
        font-size: 0.85rem;
        transition: var(--trans);
        box-shadow: 0 4px 16px rgba(99, 102, 241, 0.3);
    }

    .cv-download-btn:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 22px rgba(99, 102, 241, 0.45);
        color: white;
    }

    .cv-download-btn.collapsed-btn {
        padding: 13px;
        font-size: 1rem;
    }

    .toggle-btn {
        width: 38px;
        height: 38px;
        background: none;
        border: 1px solid transparent;
        border-radius: 10px;
        color: var(--c-subtext);
        font-size: 1rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: var(--trans);
    }

    .toggle-btn:hover {
        background: rgba(255, 255, 255, 0.04);
        border-color: var(--border);
        color: var(--c-text);
    }

    .main-content {
        flex: 1;
        margin-left: var(--side-w);
        transition: var(--trans);
    }

    .sidebar.collapsed + .main-content {
        margin-left: 85px;
    }

    .toggle-btn {
        background: none;
        border: none;
        color: white;
        cursor: pointer;
        margin-right: 15px;
        font-size: 1.2rem;
    }

    .glass-container {
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid var(--border);
        border-radius: 30px;
        padding: 2.5rem;
        min-height: 80vh;
        backdrop-filter: blur(5px);
        animation: fadeIn 0.8s ease-out;
    }

    /* Ikkitalik @@ Razor uchun */
    @@keyframes rotateOrb {
        from {
            transform: rotate(0);
        }

        to {
            transform: rotate(360deg);
        }
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@media (max-width: 1024px) {
        .sidebar {
            width: 85px;
        }

        .main-content {
            margin-left: 85px;
        }

        .brand-details, .nav-info, .group-label, .v-pill, .breadcrumb span {
            display: none;
        }
    }
</style>

@code {
    private bool IsCollapsed = false;

    private void ToggleSidebar()
    {
        IsCollapsed = !IsCollapsed;
    }
}