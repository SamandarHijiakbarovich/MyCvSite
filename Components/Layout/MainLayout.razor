@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Routing
@inject NavigationManager NavigationManager

<div class="page-container @(IsMobileOpen ? "mobile-open" : "")">

    @* Mobil uchun overlay backdrop *@
    <div class="mobile-backdrop @(IsMobileOpen ? "show" : "")" @onclick="CloseMobile"></div>

    @* --- ORQA FON EFFEKTI --- *@
    <div class="bg-visuals">
        <div class="glow-orb orb-1"></div>
        <div class="glow-orb orb-2"></div>
    </div>

    @* === SIDEBAR === *@
    <aside class="sidebar @(IsCollapsed ? "collapsed" : "") @(IsMobileOpen ? "mobile-visible" : "")">
        <div class="sidebar-header">
            <div class="brand-wrapper">
                <div class="logo-box">
                    <img src="images/my-photo.jpg" alt="Samandar"
                         class="logo-photo"
                         onerror="this.style.display='none'; this.parentElement.querySelector('.logo-fallback').style.display='flex';" />
                    <span class="logo-fallback">SM</span>
                </div>
                @if (!IsCollapsed)
                {
                    <div class="brand-details">
                        <span class="brand-name">Samandar M.</span>
                        <div class="status-indicator">
                            <span class="pulse-dot"></span>
                            <span class="status-text">Online</span>
                        </div>
                    </div>
                }
                @* Mobilda yopish tugmasi *@
                <button class="mobile-close-btn" @onclick="CloseMobile" aria-label="Yopish">
                    <i class="fas fa-times"></i>
                </button>
            </div>
        </div>

        <nav class="nav-container">
            <div class="nav-group">
                @if (!IsCollapsed)
                {
                    <p class="group-label">Menyu</p>
                }

                <NavLink href="" class="nav-card" Match="NavLinkMatch.All" @onclick="CloseMobile">
                    <div class="nav-card-inner">
                        <div class="nav-icon"><i class="fas fa-home"></i></div>
                        @if (!IsCollapsed)
                        {
                            <div class="nav-info"><span class="nav-title">Bosh sahifa</span></div>
                        }
                    </div>
                </NavLink>

                <NavLink href="about" class="nav-card" @onclick="CloseMobile">
                    <div class="nav-card-inner">
                        <div class="nav-icon"><i class="fas fa-user"></i></div>
                        @if (!IsCollapsed)
                        {
                            <div class="nav-info"><span class="nav-title">Men haqimda</span></div>
                        }
                    </div>
                </NavLink>

                <NavLink href="projects" class="nav-card" @onclick="CloseMobile">
                    <div class="nav-card-inner">
                        <div class="nav-icon"><i class="fas fa-folder-open"></i></div>
                        @if (!IsCollapsed)
                        {
                            <div class="nav-info"><span class="nav-title">Loyihalar</span></div>
                        }
                    </div>
                </NavLink>

                <NavLink href="skills" class="nav-card" @onclick="CloseMobile">
                    <div class="nav-card-inner">
                        <div class="nav-icon"><i class="fas fa-code"></i></div>
                        @if (!IsCollapsed)
                        {
                            <div class="nav-info"><span class="nav-title">Ko'nikmalar</span></div>
                        }
                    </div>
                </NavLink>

                <NavLink href="services" class="nav-card" @onclick="CloseMobile">
                    <div class="nav-card-inner">
                        <div class="nav-icon"><i class="fas fa-briefcase"></i></div>
                        @if (!IsCollapsed)
                        {
                            <div class="nav-info"><span class="nav-title">Xizmatlar</span></div>
                        }
                    </div>
                </NavLink>

                <NavLink href="contact" class="nav-card" @onclick="CloseMobile">
                    <div class="nav-card-inner">
                        <div class="nav-icon"><i class="fas fa-envelope"></i></div>
                        @if (!IsCollapsed)
                        {
                            <div class="nav-info"><span class="nav-title">Aloqa</span></div>
                        }
                    </div>
                </NavLink>
            </div>
        </nav>

        <div class="sidebar-bottom">
            @if (!IsCollapsed)
            {
                <a href="files/SamandarResume.pdf" download class="cv-download-btn">
                    <i class="fas fa-file-download"></i>
                    <span>CV yuklab olish</span>
                </a>
            }
            else
            {
                <a href="files/SamandarResume.pdf" download class="cv-download-btn collapsed-btn" title="CV yuklab olish">
                    <i class="fas fa-file-download"></i>
                </a>
            }
        </div>
    </aside>

    @* === ASOSIY KONTENT === *@
    <main class="main-content">
        <header class="top-bar">
            <div class="breadcrumb">
                <button class="toggle-btn desktop-only" @onclick="ToggleSidebar" aria-label="Menu">
                    <i class="fas fa-bars"></i>
                </button>
                <button class="toggle-btn mobile-only" @onclick="OpenMobile" aria-label="Menu">
                    <i class="fas fa-bars"></i>
                </button>
                <span class="page-name">Samandar Mamasoatov</span>
            </div>
            <div class="top-actions">
                <a href="https://github.com/SamandarHijiakbarovich" target="_blank" rel="noopener" class="action-btn" title="GitHub">
                    <i class="fab fa-github"></i>
                </a>
                <a href="https://t.me/LinuxInstructor" target="_blank" rel="noopener" class="action-btn" title="Telegram">
                    <i class="fab fa-telegram-plane"></i>
                </a>
                <a href="mailto:mamasoatovsamandar@gmail.com" class="action-btn" title="Email">
                    <i class="fas fa-envelope"></i>
                </a>
            </div>
        </header>

        <div class="content-wrapper">
            <div class="glass-container">
                @Body
            </div>
        </div>
    </main>
</div>

<style>
    :root {
        --side-w: 280px;
        --side-w-collapsed: 80px;
        --c-bg: #030712;
        --c-side: rgba(11, 15, 26, 0.95);
        --c-accent: #6366f1;
        --c-accent-glow: rgba(99, 102, 241, 0.4);
        --c-text: #f9fafb;
        --c-subtext: #94a3b8;
        --glass: rgba(255, 255, 255, 0.03);
        --border: rgba(255, 255, 255, 0.08);
        --grad: linear-gradient(135deg, #6366f1 0%, #a855f7 100%);
        --trans: all 0.35s cubic-bezier(0.23, 1, 0.32, 1);
    }

    /* === BACKGROUND === */
    .bg-visuals {
        position: fixed;
        inset: 0;
        z-index: -1;
        overflow: hidden;
        background: var(--c-bg);
    }

    .glow-orb {
        position: absolute;
        border-radius: 50%;
        filter: blur(100px);
        opacity: 0.15;
    }

    .orb-1 {
        width: 500px;
        height: 500px;
        background: var(--c-accent);
        top: -100px;
        right: -100px;
    }

    .orb-2 {
        width: 400px;
        height: 400px;
        background: #a855f7;
        bottom: -100px;
        left: -100px;
    }

    .page-container {
        display: flex;
        min-height: 100vh;
    }

    /* === MOBILE BACKDROP === */
    .mobile-backdrop {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.6);
        backdrop-filter: blur(3px);
        z-index: 99;
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .mobile-backdrop.show {
        opacity: 1;
    }

    /* === SIDEBAR === */
    .sidebar {
        width: var(--side-w);
        height: 100vh;
        background: var(--c-side);
        position: fixed;
        top: 0;
        left: 0;
        border-right: 1px solid var(--border);
        display: flex;
        flex-direction: column;
        z-index: 100;
        backdrop-filter: blur(12px);
        transition: var(--trans);
    }

    .sidebar.collapsed {
        width: var(--side-w-collapsed);
    }

    .sidebar-header {
        padding: 1.5rem 1rem 1rem;
    }

    .brand-wrapper {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 10px 12px;
        background: rgba(255,255,255,0.02);
        border-radius: 16px;
        border: 1px solid var(--border);
        min-width: 0;
        position: relative;
    }

    .brand-details {
        min-width: 0;
        flex: 1;
        overflow: hidden;
    }

    .brand-name {
        display: block;
        font-weight: 700;
        font-size: 0.92rem;
        color: var(--c-text);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .status-indicator {
        display: flex;
        align-items: center;
        gap: 6px;
        margin-top: 2px;
        font-size: 0.7rem;
        color: #10b981;
        font-weight: 500;
    }

    .pulse-dot {
        width: 7px;
        height: 7px;
        background: #10b981;
        border-radius: 50%;
        box-shadow: 0 0 8px #10b981;
        animation: pulse 2s infinite;
        flex-shrink: 0;
    }

    @@keyframes pulse {
        0%, 100% { opacity: 1; transform: scale(1); }
        50%      { opacity: 0.5; transform: scale(1.25); }
    }

    .logo-box {
        width: 42px;
        height: 42px;
        min-width: 42px;
        background: var(--grad);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        flex-shrink: 0;
        overflow: hidden;
        box-shadow: 0 4px 14px rgba(99, 102, 241, 0.3);
    }

    .logo-photo {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .logo-fallback {
        display: none;
        width: 100%;
        height: 100%;
        align-items: center;
        justify-content: center;
        font-weight: 900;
        font-size: 1rem;
        color: white;
    }

    .mobile-close-btn {
        display: none;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid var(--border);
        border-radius: 10px;
        width: 36px;
        height: 36px;
        color: var(--c-text);
        font-size: 1rem;
        cursor: pointer;
        align-items: center;
        justify-content: center;
        margin-left: auto;
    }

    /* === NAV === */
    .nav-container {
        flex: 1;
        padding: 0 0.75rem;
        overflow-y: auto;
    }

    .group-label {
        font-size: 0.62rem;
        color: var(--c-subtext);
        letter-spacing: 2.5px;
        margin: 1.2rem 0.5rem 0.6rem;
        text-transform: uppercase;
        font-weight: 700;
    }

    .nav-card {
        text-decoration: none;
        display: block;
        margin-bottom: 4px;
        border: none;
        background: none;
        width: 100%;
        cursor: pointer;
        padding: 0;
    }

    .nav-card-inner {
        display: flex;
        align-items: center;
        padding: 11px 12px;
        border-radius: 12px;
        transition: var(--trans);
        border: 1px solid transparent;
    }

    .nav-icon {
        width: 38px;
        height: 38px;
        min-width: 38px;
        background: var(--glass);
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--c-subtext);
        font-size: 1rem;
        margin-right: 12px;
        transition: 0.3s;
    }

    .collapsed .nav-icon {
        margin-right: 0;
    }

    .nav-title {
        display: block;
        font-weight: 600;
        font-size: 0.9rem;
        color: var(--c-text);
        text-align: left;
    }

    .nav-card:hover .nav-card-inner {
        background: var(--glass);
        transform: translateX(3px);
    }

    .nav-card.active .nav-card-inner {
        background: rgba(99, 102, 241, 0.1);
        border-left: 3px solid var(--c-accent);
    }

    .nav-card.active .nav-icon {
        background: var(--grad);
        color: white;
        box-shadow: 0 0 12px var(--c-accent-glow);
    }

    /* === SIDEBAR BOTTOM === */
    .sidebar-bottom {
        padding: 1rem 0.9rem 1.2rem;
    }

    .cv-download-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        padding: 12px 14px;
        background: var(--grad);
        color: white;
        border-radius: 12px;
        text-decoration: none;
        font-weight: 600;
        font-size: 0.85rem;
        transition: var(--trans);
        box-shadow: 0 4px 16px rgba(99, 102, 241, 0.3);
    }

    .cv-download-btn:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 22px rgba(99, 102, 241, 0.45);
        color: white;
    }

    .cv-download-btn.collapsed-btn {
        padding: 12px;
        font-size: 1rem;
    }

    /* === MAIN CONTENT === */
    .main-content {
        flex: 1;
        margin-left: var(--side-w);
        transition: var(--trans);
        min-width: 0;
    }

    .sidebar.collapsed + .main-content {
        margin-left: var(--side-w-collapsed);
    }

    /* === TOP BAR === */
    .top-bar {
        height: 60px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 1.5rem;
        background: rgba(3, 7, 18, 0.6);
        backdrop-filter: blur(12px);
        position: sticky;
        top: 0;
        z-index: 90;
        border-bottom: 1px solid var(--border);
    }

    .breadcrumb {
        display: flex;
        align-items: center;
        gap: 12px;
        min-width: 0;
        flex: 1;
    }

    .page-name {
        font-size: 0.92rem;
        font-weight: 600;
        color: var(--c-text);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .top-actions {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .action-btn {
        width: 36px;
        height: 36px;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid var(--border);
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--c-subtext);
        font-size: 0.9rem;
        text-decoration: none;
        transition: var(--trans);
        flex-shrink: 0;
    }

    .action-btn:hover {
        background: rgba(99, 102, 241, 0.1);
        border-color: rgba(99, 102, 241, 0.3);
        color: var(--c-text);
    }

    .toggle-btn {
        width: 38px;
        height: 38px;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid var(--border);
        border-radius: 10px;
        color: var(--c-subtext);
        font-size: 1rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: var(--trans);
        flex-shrink: 0;
    }

    .toggle-btn:hover {
        background: rgba(255, 255, 255, 0.06);
        color: var(--c-text);
    }

    .mobile-only { display: none; }
    .desktop-only { display: flex; }

    /* === CONTENT === */
    .content-wrapper {
        padding: 1.5rem;
    }

    .glass-container {
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid var(--border);
        border-radius: 24px;
        padding: 1.8rem;
        min-height: 75vh;
        backdrop-filter: blur(5px);
        animation: fadeIn 0.6s ease-out;
    }

    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(15px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    /* === TABLET (≤1024px) === */
    @@media (max-width: 1024px) {
        :root { --side-w: 260px; }
    }

    /* === MOBILE (≤768px) === */
    @@media (max-width: 768px) {
        /* Sidebar mobile drawer */
        .sidebar {
            width: 280px;
            transform: translateX(-100%);
            box-shadow: 4px 0 30px rgba(0, 0, 0, 0.5);
        }

        .sidebar.mobile-visible {
            transform: translateX(0);
        }

        .main-content {
            margin-left: 0 !important;
        }

        .mobile-backdrop {
            display: block;
        }

        .mobile-close-btn {
            display: flex;
        }

        .mobile-only { display: flex; }
        .desktop-only { display: none; }

        /* Tighter layouts on mobile */
        .top-bar {
            padding: 0 1rem;
            height: 56px;
        }

        .page-name {
            font-size: 0.85rem;
        }

        .top-actions {
            gap: 4px;
        }

        .action-btn {
            width: 34px;
            height: 34px;
            font-size: 0.85rem;
        }

        .content-wrapper {
            padding: 1rem;
        }

        .glass-container {
            padding: 1.2rem;
            border-radius: 18px;
            min-height: 70vh;
        }

        /* Reduce orb sizes on mobile */
        .orb-1 { width: 300px; height: 300px; }
        .orb-2 { width: 250px; height: 250px; }
    }

    /* === SMALL MOBILE (≤480px) === */
    @@media (max-width: 480px) {
        .top-bar {
            padding: 0 0.75rem;
        }

        .page-name {
            font-size: 0.8rem;
        }

        .content-wrapper {
            padding: 0.75rem;
        }

        .glass-container {
            padding: 1rem;
            border-radius: 16px;
        }

        /* Hide one action button to save space */
        .top-actions .action-btn:nth-child(3) {
            display: none;
        }
    }
</style>

@code {
    private bool IsCollapsed = false;
    private bool IsMobileOpen = false;

    private void ToggleSidebar()
    {
        IsCollapsed = !IsCollapsed;
    }

    private void OpenMobile()
    {
        IsMobileOpen = true;
    }

    private void CloseMobile()
    {
        IsMobileOpen = false;
    }
}
