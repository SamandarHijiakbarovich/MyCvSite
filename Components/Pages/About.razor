@page "/about"
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation

<PageTitle>Men haqimda | Samandar Mamasoatov</PageTitle>

<div class="about-wrapper">
    <div class="bg-glow"></div>
    <div class="bg-grid"></div>

    <div class="container py-5">

        @* === HERO SECTION === *@
        <div class="row align-items-center mb-5 hero-row">
            <div class="col-lg-7 order-2 order-lg-1">
                <div class="cyber-badge animate-fade-in mb-3">
                    <span class="pulse-icon"></span>
                    .NET BACKEND DASTURCHI
                </div>
                <h1 class="main-title mb-3">
                    Samandar <span class="gradient-text">Mamasoatov</span>
                </h1>
                <p class="lead-text mb-4">
                    Salom! Men .NET dasturchisiman.
                    Asosiy yo'nalishim — <span class="highlight">xavfsiz backend</span> tizimlar qurish.
                </p>
                <p class="description mb-5">
                    Ikki yildan ortiq vaqt davomida ASP.NET Core, EF Core va PostgreSQL bilan ishlab kelaman.
                    Kod yozayotganimda eng birinchi o'ylaydigan narsam — xavfsizlik. Shuning uchun har bir
                    loyihada autentifikatsiya, ma'lumotlar shifrlash va OWASP qoidalariga alohida e'tibor beraman.
                    Hozir EduProctor va TATU Inkubatsiya markazida real loyihalar ustida ishlayapman.
                </p>

                <div class="action-buttons d-flex gap-3">
                    <a href="files/SamandarResume.pdf" download="SamandarResume.pdf"
                       class="btn-cyber-primary text-decoration-none">
                        <i class="fas fa-shield-alt me-2"></i> CV YUKLAB OLISH
                    </a>
                    <button class="btn-cyber-outline" @onclick='() => Navigation.NavigateTo("/contact")'>
                        <i class="fas fa-terminal me-2"></i> BOG'LANISH
                    </button>
                </div>
            </div>

            <div class="col-lg-5 order-1 order-lg-2 mb-5 mb-lg-0 text-center">
                <div class="image-container">
                    <div class="hex-border">
                        <div class="image-frame">
                            <img src="images/my-photo.jpg" alt="Samandar"
                                 onerror="this.src='https://ui-avatars.com/api/?name=Samandar+Mamasoatov&background=6366f1&color=fff&size=512'" />
                        </div>
                    </div>
                    <div class="float-tag t-1"><i class="fas fa-lock me-1"></i> SSL</div>
                    <div class="float-tag t-2"><i class="fas fa-key me-1"></i> OAuth2</div>
                    <div class="float-tag t-3"><i class="fas fa-bug me-1"></i> Pentest</div>
                </div>
            </div>
        </div>

        @* === STATS SECTION === *@
        <div class="row mb-5">
            <div class="col-12">
                <div class="stats-grid">
                    <div class="stat-card">
                        <h3 class="stat-num">2+</h3>
                        <p class="stat-desc">Yillik Tajriba</p>
                    </div>
                    <div class="stat-card">
                        <h3 class="stat-num">15+</h3>
                        <p class="stat-desc">Xavfsiz Loyihalar</p>
                    </div>
                    <div class="stat-card">
                        <h3 class="stat-num">100%</h3>
                        <p class="stat-desc">Tizim Barqarorligi</p>
                    </div>
                </div>
            </div>
        </div>

        @* === WORK EXPERIENCE TIMELINE === *@
        <div class="row mb-5">
            <div class="col-12">
                <div class="section-heading mb-4">
                    <i class="fas fa-briefcase me-2"></i>
                    <span>ISH TAJRIBASI</span>
                </div>
                <div class="timeline">

                    <div class="timeline-item">
                        <div class="timeline-dot active"></div>
                        <div class="timeline-content">
                            <div class="timeline-header">
                                <div>
                                    <h4 class="timeline-title">Backend Dasturchi</h4>
                                    <span class="timeline-company">EduProctor</span>
                                </div>
                                <span class="timeline-period current">2025 — Hozir</span>
                            </div>
                            <p class="timeline-desc">
                                AI asosida ishlovchi onlayn imtihon nazorat tizimini backend qismini loyihalash va
                                yaratish. SignalR orqali real-vaqt monitoring, JWT autentifikatsiya va xavfsiz
                                API arxitekturasi.
                            </p>
                            <div class="timeline-tags">
                                <span>ASP.NET Core</span>
                                <span>SignalR</span>
                                <span>EF Core</span>
                                <span>PostgreSQL</span>
                                <span>JWT</span>
                            </div>
                        </div>
                    </div>

                    <div class="timeline-item">
                        <div class="timeline-dot active"></div>
                        <div class="timeline-content">
                            <div class="timeline-header">
                                <div>
                                    <h4 class="timeline-title">.NET Backend Dasturchi</h4>
                                    <span class="timeline-company">TATU Inkubatsiya Markazi</span>
                                </div>
                                <span class="timeline-period current">2025 — Hozir</span>
                            </div>
                            <p class="timeline-desc">
                                Startap loyihalar uchun backend xizmatlarini yaratish, Clean Architecture
                                asosida API loyihalash, xavfsizlik auditi va yangi dasturchilar uchun
                                mentorlik.
                            </p>
                            <div class="timeline-tags">
                                <span>Clean Architecture</span>
                                <span>C#</span>
                                <span>Docker</span>
                                <span>SQL Server</span>
                            </div>
                        </div>
                    </div>

                    <div class="timeline-item">
                        <div class="timeline-dot"></div>
                        <div class="timeline-content">
                            <div class="timeline-header">
                                <div>
                                    <h4 class="timeline-title">Junior .NET Dasturchi</h4>
                                    <span class="timeline-company">LiderBooks</span>
                                </div>
                                <span class="timeline-period">2024 — 2025</span>
                            </div>
                            <p class="timeline-desc">
                                Kitob savdosi platformasi uchun e-commerce backend tizimini ishlab chiqish.
                                To'lov tizimlari integratsiyasi, mahsulot katalogi API va foydalanuvchi
                                autentifikatsiya moduli.
                            </p>
                            <div class="timeline-tags">
                                <span>ASP.NET Core</span>
                                <span>EF Core</span>
                                <span>Redis</span>
                                <span>SQL Server</span>
                                <span>LINQ</span>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>

        @* === SKILLS SECTION === *@
        <div class="row g-4 mt-2">
            <div class="col-md-6">
                <div class="skill-group-card">
                    <div class="card-header-cyber">
                        <i class="fas fa-server me-2"></i> BACKEND ARCHITECTURE
                    </div>
                    <div class="skill-body">
                        @foreach (var skill in BackendSkills)
                        {
                            <div class="skill-box">
                                <div class="d-flex justify-content-between">
                                    <span>@skill.Name</span>
                                    <span>@skill.Percent%</span>
                                </div>
                                <div class="progress-container">
                                    <div class="progress-fill" style="width: @(skill.Percent)%"></div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="skill-group-card">
                    <div class="card-header-cyber">
                        <i class="fas fa-user-shield me-2"></i> SECURITY & DEVOPS
                    </div>
                    <div class="skill-body">
                        @foreach (var skill in SecuritySkills)
                        {
                            <div class="skill-box">
                                <div class="d-flex justify-content-between">
                                    <span>@skill.Name</span>
                                    <span>@skill.Percent%</span>
                                </div>
                                <div class="progress-container security">
                                    <div class="progress-fill" style="width: @(skill.Percent)%"></div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<style>
    .about-wrapper {
        position: relative;
        overflow: hidden;
        min-height: 100vh;
        color: #fff;
        padding-top: 40px;
    }

    .bg-glow {
        position: absolute;
        top: 10%;
        right: 10%;
        width: 400px;
        height: 400px;
        background: radial-gradient(circle, rgba(99,102,241,0.15) 0%, transparent 70%);
        z-index: -1;
        pointer-events: none;
    }

    .bg-grid {
        position: absolute;
        inset: 0;
        background-image: linear-gradient(rgba(255,255,255,0.02) 1px, transparent 1px),
                          linear-gradient(90deg, rgba(255,255,255,0.02) 1px, transparent 1px);
        background-size: 50px 50px;
        z-index: -1;
        pointer-events: none;
    }

    .gradient-text {
        background: linear-gradient(90deg, #6366f1, #a855f7);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .main-title {
        font-size: 3.5rem;
        font-weight: 800;
    }

    .lead-text {
        font-size: 1.4rem;
        color: #cbd5e1;
    }

    .description {
        font-size: 1rem;
        color: #94a3b8;
        line-height: 1.8;
    }

    .highlight {
        color: #a855f7;
        font-weight: 600;
    }

    .cyber-badge {
        display: inline-flex;
        align-items: center;
        background: rgba(99, 102, 241, 0.1);
        border: 1px solid rgba(99, 102, 241, 0.3);
        padding: 6px 16px;
        border-radius: 50px;
        color: #818cf8;
        font-weight: 600;
        font-size: 0.85rem;
        letter-spacing: 1px;
    }

    .pulse-icon {
        width: 8px;
        height: 8px;
        background: #818cf8;
        border-radius: 50%;
        margin-right: 10px;
        box-shadow: 0 0 10px #818cf8;
        animation: pulse 2s infinite;
    }

    /* Buttons */
    .btn-cyber-primary {
        background: linear-gradient(135deg, #6366f1, #a855f7);
        border: none;
        padding: 14px 28px;
        border-radius: 12px;
        color: white;
        font-weight: 700;
        transition: 0.3s;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
    }

    .btn-cyber-primary:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 25px rgba(99, 102, 241, 0.4);
        color: white;
    }

    .btn-cyber-outline {
        background: transparent;
        border: 2px solid rgba(168, 85, 247, 0.5);
        padding: 14px 28px;
        border-radius: 12px;
        color: white;
        font-weight: 700;
        transition: 0.3s;
        cursor: pointer;
    }

    .btn-cyber-outline:hover {
        background: rgba(168, 85, 247, 0.1);
        border-color: #a855f7;
    }

    /* Image Container */
    .image-container {
        position: relative;
        display: inline-block;
    }

    .hex-border {
        padding: 8px;
        background: linear-gradient(45deg, #6366f1, #a855f7);
        clip-path: polygon(25% 0%, 75% 0%, 100% 50%, 75% 100%, 25% 100%, 0% 50%);
    }

    .image-frame {
        background: #0f172a;
        clip-path: polygon(25% 0%, 75% 0%, 100% 50%, 75% 100%, 25% 100%, 0% 50%);
        width: 280px;
        height: 320px;
        overflow: hidden;
    }

    .image-frame img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .float-tag {
        position: absolute;
        background: rgba(15, 23, 42, 0.9);
        border: 1px solid rgba(255,255,255,0.15);
        padding: 5px 12px;
        border-radius: 8px;
        font-size: 0.8rem;
        backdrop-filter: blur(5px);
        color: #cbd5e1;
    }

    .t-1 { top: 10%; right: -20px; }
    .t-2 { bottom: 25%; left: -30px; }
    .t-3 { bottom: 5%; right: 15px; color: #ef4444; }

    /* Stats Grid */
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
        background: rgba(30, 41, 59, 0.5);
        padding: 30px;
        border-radius: 24px;
        border: 1px solid rgba(255,255,255,0.05);
        backdrop-filter: blur(10px);
        text-align: center;
    }

    .stat-num {
        font-size: 2.5rem;
        font-weight: 800;
        color: #6366f1;
        margin: 0;
    }

    .stat-desc {
        color: #94a3b8;
        margin: 5px 0 0 0;
        font-size: 0.9rem;
    }

    /* Section Heading */
    .section-heading {
        display: flex;
        align-items: center;
        font-size: 0.8rem;
        font-weight: 700;
        color: #6366f1;
        letter-spacing: 2px;
        text-transform: uppercase;
    }

    /* Timeline */
    .timeline {
        position: relative;
        padding-left: 30px;
    }

    .timeline::before {
        content: '';
        position: absolute;
        left: 8px;
        top: 10px;
        bottom: 10px;
        width: 2px;
        background: linear-gradient(to bottom, #6366f1, #a855f7, transparent);
    }

    .timeline-item {
        position: relative;
        margin-bottom: 35px;
    }

    .timeline-dot {
        position: absolute;
        left: -26px;
        top: 8px;
        width: 16px;
        height: 16px;
        border-radius: 50%;
        background: rgba(99, 102, 241, 0.2);
        border: 2px solid rgba(99, 102, 241, 0.4);
    }

    .timeline-dot.active {
        background: #6366f1;
        border-color: #6366f1;
        box-shadow: 0 0 12px rgba(99, 102, 241, 0.6);
        animation: pulse 2.5s infinite;
    }

    .timeline-content {
        background: rgba(30, 41, 59, 0.5);
        border: 1px solid rgba(255,255,255,0.06);
        border-radius: 18px;
        padding: 22px 26px;
        backdrop-filter: blur(5px);
        transition: 0.3s;
    }

    .timeline-content:hover {
        border-color: rgba(99, 102, 241, 0.3);
        transform: translateX(5px);
    }

    .timeline-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 10px;
        gap: 12px;
        flex-wrap: wrap;
    }

    .timeline-title {
        font-size: 1.1rem;
        font-weight: 700;
        color: #f8fafc;
        margin: 0 0 4px 0;
    }

    .timeline-company {
        color: #818cf8;
        font-size: 0.9rem;
        font-weight: 600;
    }

    .timeline-period {
        background: rgba(99, 102, 241, 0.1);
        border: 1px solid rgba(99, 102, 241, 0.2);
        color: #94a3b8;
        padding: 4px 12px;
        border-radius: 50px;
        font-size: 0.8rem;
        white-space: nowrap;
    }

    .timeline-period.current {
        background: rgba(16, 185, 129, 0.1);
        border-color: rgba(16, 185, 129, 0.3);
        color: #10b981;
    }

    .timeline-desc {
        color: #94a3b8;
        font-size: 0.9rem;
        line-height: 1.7;
        margin: 10px 0;
    }

    .timeline-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 7px;
        margin-top: 12px;
    }

    .timeline-tags span {
        background: rgba(99, 102, 241, 0.08);
        color: #818cf8;
        border: 1px solid rgba(99, 102, 241, 0.2);
        padding: 3px 10px;
        border-radius: 6px;
        font-size: 0.75rem;
        font-weight: 600;
    }

    /* Skill Cards */
    .skill-group-card {
        background: rgba(30, 41, 59, 0.4);
        border-radius: 20px;
        border: 1px solid rgba(255,255,255,0.05);
        overflow: hidden;
    }

    .card-header-cyber {
        background: rgba(255,255,255,0.03);
        padding: 15px 20px;
        font-weight: 700;
        letter-spacing: 1px;
        border-bottom: 1px solid rgba(255,255,255,0.05);
        color: #cbd5e1;
        font-size: 0.85rem;
    }

    .skill-body {
        padding: 25px;
    }

    .skill-box {
        margin-bottom: 18px;
        font-size: 0.9rem;
        color: #cbd5e1;
    }

    .progress-container {
        height: 8px;
        background: #0f172a;
        border-radius: 10px;
        margin-top: 8px;
        overflow: hidden;
    }

    .progress-fill {
        height: 100%;
        background: linear-gradient(90deg, #6366f1, #a855f7);
        border-radius: 10px;
        transition: width 1.5s ease;
    }

    .security .progress-fill {
        background: linear-gradient(90deg, #a855f7, #ec4899);
    }

    @@keyframes pulse {
        0%, 100% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.6; transform: scale(1.2); }
    }

    @@media (max-width: 768px) {
        .main-title { font-size: 2.5rem; }
        .stats-grid { grid-template-columns: 1fr; }
        .timeline-header { flex-direction: column; }
        .action-buttons { flex-direction: column; }
    }
</style>

@code {
    private List<SkillItem> BackendSkills = new() {
        new("C# & .NET Core Architecture", 95),
        new("ASP.NET Core / Web API", 92),
        new("EF Core & LINQ", 88),
        new("SQL Server / PostgreSQL", 87),
        new("Redis & Caching", 75),
        new("xUnit & Testing", 72)
    };

    private List<SkillItem> SecuritySkills = new() {
        new("JWT & OAuth2 Implementation", 94),
        new("OWASP Top 10 & Security Audit", 85),
        new("SignalR Real-time Systems", 80),
        new("Docker & Containerization", 75),
        new("Clean Architecture / DDD", 88),
        new("Git & CI/CD", 85)
    };

    public record SkillItem(string Name, int Percent);
}
