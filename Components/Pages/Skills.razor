@page "/skills"
@inject NavigationManager Navigation

<PageTitle>Ko'nikmalar | Samandar Mamasoatov</PageTitle>

<div class="skills-page-wrapper">
    <div class="cyber-grid"></div>
    <div class="glow-orb"></div>
    <div class="glow-orb-secondary"></div>

    <section class="container py-5 position-relative" style="z-index: 2;">
        <div class="text-center mb-5 animate__animated animate__fadeInDown">
            <div class="page-badge mb-3">TECH STACK</div>
            <h1 class="display-4 fw-bold glitch-text">
                TEXNIK <span class="highlight-gradient">KO'NIKMALAR</span>
            </h1>
            <p class="lead custom-subtitle mx-auto">
                Backend arxitekturasi, ma'lumotlar bazasi va xavfsizlik bo'yicha professional texnologik stack.
            </p>
            <div class="divider-cyber mx-auto"></div>
        </div>

        @* === SKILL PROGRESS BARS === *@
        <div class="row g-4 mb-5">
            @foreach (var item in MainSkills)
            {
                <div class="col-lg-6 animate__animated animate__zoomIn">
                    <div class="skill-container-card">
                        <div class="card-content">
                            <div class="skill-item-box">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <div class="d-flex align-items-center">
                                        <div class="icon-box" style="background: @(item.Color + "20"); border: 1px solid @item.Color">
                                            <i class="@item.Icon" style="color: @item.Color;"></i>
                                        </div>
                                        <span class="skill-name ms-3">@item.Name</span>
                                    </div>
                                    <span class="percentage-badge" style="color: @item.Color; border-color: @item.Color">
                                        @item.Level%
                                    </span>
                                </div>
                                <div class="progress-bg">
                                    <div class="progress-fill"
                                         style="width: @item.Level%; background: linear-gradient(90deg, @item.Color, @item.ColorEnd); box-shadow: 0 0 12px @item.Color;">
                                    </div>
                                </div>
                                @if (!string.IsNullOrEmpty(item.Description))
                                {
                                    <p class="skill-desc mt-2 mb-0">@item.Description</p>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* === TECH BADGE GRID === *@
        <div class="badges-section mb-5">
            <h3 class="badges-title">TEXNOLOGIYALAR</h3>
            <div class="badge-grid">
                @foreach (var badge in TechBadges)
                {
                    <div class="tech-badge-card">
                        <i class="@badge.Icon" style="color: @badge.Color; font-size: 1.8rem; margin-bottom: 8px; display:block;"></i>
                        <span>@badge.Name</span>
                        @if (!string.IsNullOrEmpty(badge.Category))
                        {
                            <small>@badge.Category</small>
                        }
                    </div>
                }
            </div>
        </div>

        @* === CTA === *@
        <div class="text-center mt-5 animate__animated animate__fadeInUp">
            <p class="text-muted-custom">Loyihangiz uchun xavfsiz va tezkor backend kerakmi?</p>
            <button class="btn-cyber-contact" @onclick='() => Navigation.NavigateTo("/contact")'>
                <i class="fas fa-paper-plane me-2"></i> MEN BILAN BOG'LANISH
            </button>
        </div>
    </section>
</div>

<style>
    :root {
        --bg-deep: #0f172a;
        --card-dark: #1e293b;
        --text-bright: #f8fafc;
        --text-dim: #94a3b8;
    }

    .skills-page-wrapper {
        min-height: 100vh;
        background-color: var(--bg-deep);
        position: relative;
        overflow: hidden;
        padding-top: 60px;
        color: var(--text-bright);
    }

    .cyber-grid {
        position: absolute;
        inset: 0;
        background-image: linear-gradient(rgba(59, 130, 246, 0.04) 1px, transparent 1px),
                          linear-gradient(90deg, rgba(59, 130, 246, 0.04) 1px, transparent 1px);
        background-size: 40px 40px;
        z-index: 1;
        pointer-events: none;
    }

    .glow-orb {
        position: absolute;
        top: 10%;
        right: -5%;
        width: 500px;
        height: 500px;
        background: radial-gradient(circle, rgba(59, 130, 246, 0.12) 0%, transparent 70%);
        filter: blur(80px);
        z-index: 0;
        pointer-events: none;
    }

    .glow-orb-secondary {
        position: absolute;
        bottom: 10%;
        left: -5%;
        width: 400px;
        height: 400px;
        background: radial-gradient(circle, rgba(139, 92, 246, 0.1) 0%, transparent 70%);
        filter: blur(60px);
        z-index: 0;
        pointer-events: none;
    }

    .page-badge {
        display: inline-block;
        background: rgba(99, 102, 241, 0.1);
        border: 1px solid rgba(99, 102, 241, 0.25);
        color: #818cf8;
        padding: 5px 18px;
        border-radius: 50px;
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 2px;
    }

    .glitch-text {
        font-size: 3.2rem;
        letter-spacing: 2px;
    }

    .highlight-gradient {
        background: linear-gradient(90deg, #3b82f6, #8b5cf6);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .custom-subtitle {
        color: var(--text-dim);
        max-width: 650px;
        line-height: 1.6;
    }

    .divider-cyber {
        width: 120px;
        height: 4px;
        background: linear-gradient(90deg, #3b82f6, #ec4899);
        border-radius: 10px;
        margin-top: 20px;
        box-shadow: 0 0 10px rgba(59, 130, 246, 0.5);
    }

    /* Skill Card */
    .skill-container-card {
        background: rgba(30, 41, 59, 0.5);
        border-radius: 18px;
        border: 1px solid rgba(255, 255, 255, 0.05);
        transition: 0.35s;
    }

    .skill-container-card:hover {
        transform: translateY(-6px);
        border-color: rgba(59, 130, 246, 0.35);
        box-shadow: 0 12px 30px rgba(0,0,0,0.35);
    }

    .card-content {
        background: #1e293b;
        padding: 26px;
        border-radius: 17px;
    }

    .icon-box {
        width: 48px;
        height: 48px;
        min-width: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        font-size: 1.4rem;
    }

    .skill-name {
        font-size: 1.15rem;
        font-weight: 700;
        color: white;
    }

    .percentage-badge {
        font-size: 0.8rem;
        font-weight: 800;
        padding: 4px 12px;
        border-radius: 20px;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid;
    }

    .progress-bg {
        height: 9px;
        background: rgba(15, 23, 42, 0.7);
        border-radius: 20px;
        overflow: hidden;
        border: 1px solid rgba(255, 255, 255, 0.04);
    }

    .progress-fill {
        height: 100%;
        border-radius: 20px;
        transition: width 1.8s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .skill-desc {
        color: var(--text-dim);
        font-size: 0.85rem;
    }

    /* Badges Section */
    .badges-section {
        background: rgba(30, 41, 59, 0.4);
        border: 1px solid rgba(255,255,255,0.05);
        border-radius: 24px;
        padding: 35px;
    }

    .badges-title {
        font-size: 0.75rem;
        font-weight: 700;
        color: #6366f1;
        letter-spacing: 3px;
        margin-bottom: 25px;
    }

    .badge-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(110px, 1fr));
        gap: 14px;
    }

    .tech-badge-card {
        background: rgba(15, 23, 42, 0.7);
        border: 1px solid rgba(255,255,255,0.07);
        border-radius: 14px;
        padding: 18px 10px;
        text-align: center;
        transition: 0.3s;
        cursor: default;
    }

    .tech-badge-card:hover {
        background: rgba(99, 102, 241, 0.08);
        border-color: rgba(99, 102, 241, 0.3);
        transform: translateY(-4px);
    }

    .tech-badge-card span {
        display: block;
        font-size: 0.8rem;
        font-weight: 600;
        color: #cbd5e1;
    }

    .tech-badge-card small {
        display: block;
        font-size: 0.65rem;
        color: #64748b;
        margin-top: 3px;
    }

    /* Button */
    .btn-cyber-contact {
        background: linear-gradient(45deg, #3b82f6, #8b5cf6);
        border: none;
        color: white;
        padding: 15px 40px;
        border-radius: 12px;
        font-weight: 700;
        transition: 0.3s;
        box-shadow: 0 0 20px rgba(139, 92, 246, 0.25);
        cursor: pointer;
    }

    .btn-cyber-contact:hover {
        transform: scale(1.05);
        box-shadow: 0 0 35px rgba(59, 130, 246, 0.5);
    }

    .text-muted-custom {
        color: #64748b;
        margin-bottom: 15px;
        font-size: 1.05rem;
    }

    @@media (max-width: 768px) {
        .glitch-text { font-size: 2.2rem; }
        .badge-grid { grid-template-columns: repeat(3, 1fr); }
    }
</style>

