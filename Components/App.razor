<!DOCTYPE html>
<html lang="uz">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />

    <title>Samandar Mamasoatov | .NET Backend Developer</title>

    <link rel="icon" type="image/png" href="favicon.png" />

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

    <link rel="stylesheet" href="css/app.css" />
    <link rel="stylesheet" href="css/portfolio.css" />
    <link rel="stylesheet" href="MyCvSite.styles.css" />

    <HeadOutlet />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="_framework/blazor.web.js"></script>

    <script>
        // Mobile navigation toggle - pure JS, ishonchli ishlaydi
        window.openMobileNav = function() {
            document.querySelector('.sidebar')?.classList.add('mobile-visible');
            document.querySelector('.mobile-backdrop')?.classList.add('show');
            document.body.style.overflow = 'hidden';
        };
        window.closeMobileNav = function() {
            document.querySelector('.sidebar')?.classList.remove('mobile-visible');
            document.querySelector('.mobile-backdrop')?.classList.remove('show');
            document.body.style.overflow = '';
        };
        // Sidebar ichida menyu bosilganda yopish
        document.addEventListener('click', function(e) {
            if (e.target.closest('.sidebar .nav-card')) {
                setTimeout(window.closeMobileNav, 100);
            }
        });
    </script>
</body>

</html>